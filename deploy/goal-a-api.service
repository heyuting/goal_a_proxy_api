[Unit]
Description=GOAL-A proxy API (gunicorn)
Documentation=https://github.com/heyuting/goal_a_proxy_api
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yhs5
Group=yhs5
WorkingDirectory=/home/yhs5/webapp/goal_a_proxy_api

# Loads BOUCHET_*, CORS_ORIGINS, DRN_MODELS_DIR, etc.
EnvironmentFile=-/home/yhs5/webapp/goal_a_proxy_api/.env

# Prefer the project venv if present; otherwise system gunicorn on PATH.
# Edit ExecStart if your venv path differs.
# Watershed generation can run up to ~600s in the Flask handler; keep
# gunicorn above that so the worker is not killed mid-request (clients then
# often see an HTML 502/504 and fail JSON.parse).
ExecStart=/home/yhs5/webapp/goal_a_proxy_api/.venv/bin/gunicorn \
  --workers 1 \
  --threads 4 \
  --bind 0.0.0.0:8000 \
  --timeout 660 \
  --graceful-timeout 60 \
  --access-logfile - \
  --error-logfile - \
  app:app

Restart=always
RestartSec=5

# Soft stop so in-flight requests can finish (incl. long watershed runs)
TimeoutStopSec=120
KillMode=mixed

# Reasonable defaults for a web process
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

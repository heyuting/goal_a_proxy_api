# Yale Spinup / Bouchet HPC proxy API
# Copy to .env and fill in real values:
#   cp .env.example .env
#   chmod 600 .env
#
# Private keys are NOT loaded by Python. Configure OpenSSH instead:
#   1) cp ssh_config.example ~/.ssh/config   (edit User / IdentityFile)
#   2) chmod 600 ~/.ssh/config ~/.ssh/id_ed25519
#   3) ./ssh_login_bouchet.sh               (complete Duo once)

BOUCHET_USER=yhs5
BOUCHET_HOST=bouchet.ycrc.yale.edu

# Local DRN R_code tree for /api/drn/generate-watershed (must contain input/data + input/shp).
# On Spinup, copy/symlink Models/DRN/R_code here, e.g.:
#   DRN_MODELS_DIR=/home/yhs5/webapp/DRN/R_code
DRN_MODELS_DIR=

# OpenSSH Host alias from ~/.ssh/config (see ssh_config.example)
SSH_HOST_ALIAS=bouchet
SSH_CONTROL_PATH=~/.ssh/cm-bouchet-%r@%h:%p
# "yes" = keep until reboot / ssh -O exit / Bouchet drops the session
SSH_CONTROL_PERSIST=yes

# Frontend origin(s) exactly as the browser sends them (scheme + host + port).
CORS_ORIGINS=http://10.5.203.164

# Local laptop frontend example:
# CORS_ORIGINS=http://localhost:5173

# Legacy aliases still work if BOUCHET_* is unset:
# GRACE_USER=yhs5
# GRACE_HOST=bouchet.ycrc.yale.edu

SSH_CONNECT_TIMEOUT_SEC=30

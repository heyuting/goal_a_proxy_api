# Yale Spinup / Bouchet HPC proxy API
# Copy to .env and fill in real values:
#   cp .env.example .env
#   chmod 600 .env

BOUCHET_USER=yhs5
BOUCHET_HOST=bouchet.ycrc.yale.edu

# Prefer a key file on the Spinup VM (authorized for your Yale HPC account).
# Duo still applies; the browser answers via /api/auth/mfa-* .
SSH_PRIVATE_KEY_PATH=/home/yhs5/.ssh/id_ed25519

# Optional: inline key (e.g. deploy environments). Not recommended for Duo login.
# SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----"

# Frontend origin(s) exactly as the browser sends them (scheme + host + port).
# Example Spinup private IP frontend (add :port if the UI is not on 80):
CORS_ORIGINS=http://10.5.203.164

# Local laptop frontend example:
# CORS_ORIGINS=http://localhost:5173

# Legacy aliases still work if BOUCHET_* is unset:
# GRACE_USER=yhs5
# GRACE_HOST=bouchet.ycrc.yale.edu

MFA_RESPONSE_TIMEOUT_SEC=150
SSH_BANNER_TIMEOUT_SEC=60
SSH_AUTH_TIMEOUT_SEC=180
